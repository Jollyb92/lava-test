# Base URL for all PDFs.
# Empty = load from the public folder (relative paths).
# Set to a server URL to load all PDFs from that server.
# Example: VITE_PDF_BASE=http://10.1.0.138:3000
VITE_PDF_BASE=

# Dev-server proxy target for /pdf-server/* (PDF file server).
# Default: http://127.0.0.1:3000 (started by start-dev.bat). Override in .env.local if the server is on another machine.
# Example: PDF_SERVER=http://10.1.0.138:3000
PDF_SERVER=

# Folder the dev server reads /pdf-forms/* from (no separate server needed).
# Default: \\lava-b-stor01\LIBRARY\4_GENERAL OFFICE\91_BER\Administrative Forms
PDF_FORMS_DIR=
